# web (monorepo): deps y build. .gitkeep solo mantiene el dir en git;
# go:embed ignora los archivos ocultos, así que go build exige pnpm build.
web/node_modules/
web/dist/*
!web/dist/.gitkeep
scripts/shots/node_modules/

# estado local de skill de diseño (no se comitea)
.impeccable/

# tooling de agentes (impeccable): no se comitea
.github/agents/
.github/hooks/
.github/skills/

# cobertura local
/cover.out
/cover
/.gocache/
/.playwright/

# estado local del servicio (db, logs, certs)
/logs/
